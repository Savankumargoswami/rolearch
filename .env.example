# Rolearch secrets. Never commit this file (.gitignore excludes .env*). Copy to .env.local and fill in.
# Supabase dashboard -> Project Settings -> API (or "Connect")

# Public: safe in the browser (row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for the job-feed worker. Supabase -> Connect -> "Session pooler" URI
# (port 5432), with your database password filled in.
DATABASE_URL=

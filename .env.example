# Rolearch secrets. Never commit this file (.gitignore excludes .env*). Copy to .env.local and fill in.
# Supabase dashboard -> Project Settings -> API (or "Connect")

# Public: safe in the browser (row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection for the job-feed worker. Supabase -> Connect -> "Session pooler" URI
# (port 5432), with your database password filled in.
DATABASE_URL=

# Claude API key for reading uploaded resumes (server only)
ANTHROPIC_API_KEY=

# Server only: lets the server publish posts that passed review (the same value is stored in private.settings in the database).
POST_REVIEW_SECRET=

# Adzuna job search API (developer.adzuna.com). Server/worker only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJOBS API (developer.usajobs.gov). Worker only.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

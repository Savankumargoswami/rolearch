{
  "manifest_version": 3,
  "name": "Rolearch: Job Fit Check",
  "short_name": "Rolearch",
  "version": "1.0.1",
  "description": "See how your resume fits the job posting you're looking at: your match, the skills you're missing, and what to fix. Free.",
  "homepage_url": "https://www.rolearch.com",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Check my fit with Rolearch",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["https://www.rolearch.com/ats*", "https://rolearch.com/ats*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "feedback-digest": {
      "schedule": "0 14 * * 1",
      "path": "/api/cron/feedback-digest",
      "requestMethod": "GET"
    },
    "daily-post": {
      "schedule": "0 13 * * *",
      "path": "/api/cron/daily-post",
      "requestMethod": "GET"
    },
    "newsletter": {
      "schedule": "30 14 * * 1",
      "path": "/api/cron/newsletter",
      "requestMethod": "GET"
    },
    "blog": {
      "schedule": "0 12 */2 * *",
      "path": "/api/cron/blog",
      "requestMethod": "GET"
    }
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "feedback-digest": {
      "schedule": "0 14 * * 1",
      "path": "/api/cron/feedback-digest",
      "requestMethod": "GET"
    },
    "daily-post": {
      "schedule": "0 13 * * *",
      "path": "/api/cron/daily-post",
      "requestMethod": "GET"
    },
    "newsletter": {
      "schedule": "30 14 * * 1",
      "path": "/api/cron/newsletter",
      "requestMethod": "GET"
    },
    "blog": {
      "schedule": "0 12 * * 0,1,3,5",
      "path": "/api/cron/blog",
      "requestMethod": "GET"
    },
    "competitor-watch": {
      "schedule": "30 13 * * 1",
      "path": "/api/cron/competitor-watch",
      "requestMethod": "GET"
    }
  }
}
